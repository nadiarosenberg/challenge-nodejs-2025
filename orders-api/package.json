{
  "name": "orders-api",
  "version": "0.0.1",
  "description": "NestJS v10 API with Sequelize and PostgreSQL",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "nest build && node dist/main.js",
    "start:dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "build": "nest build",
    "lint": "eslint '{src,apps,libs}/**/*.ts' --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "migrate": "npx ts-node -r tsconfig-paths/register ./node_modules/.bin/sequelize db:migrate --config sequelize.config.js",
    "migrate:local": "npx ts-node -r tsconfig-paths/register ./node_modules/.bin/sequelize db:migrate --config sequelize.config.js",
    "migrate:status": "npx ts-node -r tsconfig-paths/register ./node_modules/.bin/sequelize db:migrate:status --config sequelize.config.js",
    "migrate:undo": "npx ts-node -r tsconfig-paths/register ./node_modules/.bin/sequelize db:migrate:undo --config sequelize.config.js",
    "test": "jest",
    "test:cov": "jest --coverage",
    "start:cron": "ts-node -r tsconfig-paths/register src/main.ts"
  },
  "dependencies": {
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/sequelize": "^10.0.0",
    "@nestjs/swagger": "^11.2.0",
    "cache-manager": "^7.1.1",
    "cache-manager-redis-store": "^3.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "date-fns": "^4.1.0",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sequelize": "^6.37.3",
    "sequelize-typescript": "^2.1.5",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.12.12",
    "@typescript-eslint/eslint-plugin": "^7.7.1",
    "@typescript-eslint/parser": "^7.7.1",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "sequelize-cli": "^6.6.2",
    "ts-jest": "^29.4.1",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2"
  }
}
